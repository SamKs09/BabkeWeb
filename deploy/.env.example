# =============================================================================
# Babke — production environment template
# =============================================================================
# Copy to /opt/babke/.env ON THE VPS and fill in real values there.
# NEVER commit the filled-in file. NEVER paste real values into chat, tickets,
# or `docker compose config` output.
#
#   install -m 600 /opt/babke/src/deploy/.env.example /opt/babke/.env
#   chown root:root /opt/babke/.env && chmod 600 /opt/babke/.env
#
# The file lives at /opt/babke/.env — OUTSIDE /opt/babke/src/ — so wiping and
# re-cloning the source tree can never destroy the secrets.
#
# Every variable below is referenced in docker-compose.yml as ${VAR:?...}.
# A missing or empty value aborts the deploy with a named error instead of
# silently starting the app. server.js itself also refuses to boot when any
# required variable is missing, so this is the earlier of two guards.
#
# Generate every secret ON THE BOX:
#     openssl rand -hex 32      # 64 hex chars, URL-safe, use for passwords/keys
# Hex output matters for MONGO_ROOT_PASSWORD: it is embedded verbatim in a
# mongodb:// URI, so it must contain no @ : / ? # % or other reserved chars.
#
# NOT set here (fixed in docker-compose.yml, do not add them):
#   NODE_ENV=production   PORT=4000   TZ=Africa/Tunis   MONGODB_URI (assembled)
# =============================================================================


# -----------------------------------------------------------------------------
# MongoDB root credentials
# -----------------------------------------------------------------------------
# Used twice: to initialise the mongo container's root user on FIRST boot, and
# to assemble MONGODB_URI for the api container.
# WARNING: MONGO_INITDB_* only take effect on an EMPTY data volume. Changing
# either value later does NOT rotate the db user — see README "Rotating secrets".

# Not secret, but do not use "root" or "admin". Plain alphanumeric.
MONGO_ROOT_USER=babke_root

# SECRET. openssl rand -hex 32
MONGO_ROOT_PASSWORD=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# JWT signing key
# -----------------------------------------------------------------------------
# SECRET. Signs the httpOnly `admin_token` cookie (24h expiry).
# Rotating it invalidates every logged-in admin session immediately.
# openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32


# -----------------------------------------------------------------------------
# Admin panel logins — five roles
# -----------------------------------------------------------------------------
# Names taken verbatim from server.js. There is no user collection: these ten
# values ARE the entire auth surface of the admin SPA. Every password is a
# SECRET; every username is low-sensitivity but must still be changed off the
# defaults. server.js no longer has any hardcoded credential fallback: a missing
# value aborts the boot rather than silently accepting a known password.
# Passwords are compared as plain strings — no hashing — so use long random
# values and rotate by editing this file and restarting the api container.

# Role: admin — full owner access (ownerOnlyMiddleware routes).
ADMIN_USERNAME=replace-with-a-nondefault-username
# SECRET:
ADMIN_PASSWORD=replace-with-openssl-rand-hex-32

# Role: comptable — accounting views.
COMPTABLE_USERNAME=replace-with-a-nondefault-username
# SECRET:
COMPTABLE_PASSWORD=replace-with-openssl-rand-hex-32

# Role: sm_manager — social media / content. NOTE the env prefix is MEDIA_,
# but the role string server.js issues in the JWT is "sm_manager".
MEDIA_USERNAME=replace-with-a-nondefault-username
# SECRET:
MEDIA_PASSWORD=replace-with-openssl-rand-hex-32

# Role: cashier — till / order taking.
CASHIER_USERNAME=replace-with-a-nondefault-username
# SECRET:
CASHIER_PASSWORD=replace-with-openssl-rand-hex-32

# SECRET:


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Not secret. Comma-separated, NO spaces, scheme included, no trailing slash.
# Routing design A keeps all 39 frontend fetches same-origin, so in normal
# operation this list is never exercised — it is the backstop that stops a
# third-party page from making credentialed calls with a stolen cookie.
#
# Interim (nip.io, real Let's Encrypt certs, babke.tn DNS not live yet):
ALLOWED_ORIGINS=https://babke.185.172.57.237.nip.io,https://admin-babke.185.172.57.237.nip.io,https://api-babke.185.172.57.237.nip.io
#
# Final (swap in when babke.tn DNS + certs are issued):
# ALLOWED_ORIGINS=https://babke.tn,https://www.babke.tn,https://admin.babke.tn,https://api.babke.tn
